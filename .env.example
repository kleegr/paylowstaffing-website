# PayLow Staffing — Environment Variables
# Copy this file to .env.local and fill in the values.

# Public site URL (used in metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://paylowstaffing.com

# Contact form webhook (POST endpoint — e.g., GoHighLevel form URL or your own API)
# Leave empty in development to log submissions to the server console instead.
CONTACT_FORM_WEBHOOK_URL=https://lc.paylowstaffing.com/widget/form/1bJDrrS4rOrnEZPBoXDJ

# Newsletter subscribe webhook (optional)
NEWSLETTER_WEBHOOK_URL=
